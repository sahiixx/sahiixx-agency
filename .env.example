# One Person Agency (OPA) — environment variable template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All of these are also read by config/agency.yaml (which ships with null/placeholder values).

# ── GitHub (required for `opa sync` repo discovery) ──
GITHUB_TOKEN=ghp_replace_with_personal_access_token
GITHUB_USER=sahiixx

# ── OPA runtime ──
# Path to the agency config YAML (defaults to config/agency.yaml).
OPA_CONFIG=config/agency.yaml
# Optional API key gate on the FastAPI server. If set, all mutating endpoints
# require header `X-OPA-API-Key: <value>`. Leave blank to disable (NOT recommended
# for any non-localhost deployment).
OPA_API_KEY=

# ── MCP server (mcp_server/main.py) ──
# stdio (default) or sse. SSE binds 0.0.0.0:<port> — gate behind a proxy if exposed.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8081

# ── Telegram bot (sahiixx_agency/telegram/bot.py) ──
TELEGRAM_BOT_TOKEN=
# Comma-separated integer chat IDs allowed to control the bot. Empty = allow ALL
# (security risk if the token leaks). Set to your own chat ID(s).
TELEGRAM_ALLOWED_CHAT_IDS=

# ── LLM providers (core/llm.py — all optional; providers are pluggable) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Ollama runs locally; no key needed. Override base URL only if non-default.
OLLAMA_BASE_URL=http://127.0.0.1:11434